# --- Okta (from your OIDC Web app) ---
# Issuer of the authorization server that signs the ID token.
# Default custom auth server: https://<your-org>.okta.com/oauth2/default
OKTA_ISSUER=https://your-org.okta.com/oauth2/default
OKTA_CLIENT_ID=0oaXXXXXXXXXXXXXXXXX
OKTA_CLIENT_SECRET=change-me
OKTA_REDIRECT_URI=http://localhost:5000/callback

# --- AWS credentials ---
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=change-me

# --- AWS ---
# Must be the region where IAM Identity Center is enabled.
AWS_REGION=us-east-1
# Must be globally unique.
S3_BUCKET=okta-s3-demo-change-me
S3_KEY=demo/hello.txt
# Okta user who gets the S3 Access Grant (must already be in Identity Center via SCIM).
DEMO_USER_EMAIL=alice@example.com

# --- IAM Identity Center (already configured) ---
# From: AWS Console → IAM Identity Center → Settings → Instance ARN
INSTANCE_ARN=arn:aws:sso:::instance/ssoins-XXXXXXXXXXXXXXXXX
# From: AWS Console → IAM Identity Center → Settings → Identity store ID
IDENTITY_STORE_ID=d-XXXXXXXXXX
# From: AWS Console → IAM Identity Center → Settings → Trusted token issuers → your issuer → ARN
TTI_ARN=arn:aws:sso:::trustedTokenIssuer/ssoins-XXXXXXXXXXXXXXXXX/tti-XXXXXXXXXXXXXXXXX

# --- Printed by `python setup_aws.py` ---
APP_ROLE_ARN=
IDC_APPLICATION_ARN=

# --- Flask ---
FLASK_SECRET_KEY=change-me
